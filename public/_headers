# Cloudflare Pages — Headers HTTP pour les fichiers statiques

# Fichiers JS/CSS statiques — no-store : Safari doit TOUJOURS refetch
/static/*.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  X-Content-Type-Options: nosniff

/static/*.css
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  X-Content-Type-Options: nosniff


# Images et assets
/static/*.png
  Cache-Control: public, max-age=86400
/static/*.jpg
  Cache-Control: public, max-age=86400
/static/*.svg
  Cache-Control: public, max-age=86400
/static/*.ico
  Cache-Control: public, max-age=86400

# Sécurité globale
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
